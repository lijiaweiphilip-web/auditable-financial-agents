{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auditable financial-agent artifact case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "claims"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "metadata": {"type": "object"},
    "expected_action_count": {"type": ["integer", "null"], "minimum": 0},
    "expected_executed_action_count": {"type": ["integer", "null"], "minimum": 0}
  },
  "$defs": {
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "generated_value": {"type": ["number", "null"]},
        "source_value": {"type": ["number", "null"]},
        "materiality_threshold": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "provenance_valid": {"type": "boolean"},
        "entity_aligned": {"type": "boolean"},
        "period_aligned": {"type": "boolean"},
        "metric_aligned": {"type": "boolean"},
        "formula_check": {"type": "string", "enum": ["pass", "fail", "unknown"]},
        "qualitative_severity": {"type": "number", "minimum": 0},
        "note": {"type": "string"}
      },
      "oneOf": [
        {"required": ["generated_value", "source_value", "materiality_threshold"]},
        {"not": {"anyOf": [
          {"required": ["generated_value"]},
          {"required": ["source_value"]},
          {"required": ["materiality_threshold"]}
        ]}}
      ]
    },
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["action_id", "tool", "status"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["proposed", "executed", "failed", "skipped"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "result_digest": {"$ref": "#/$defs/digest"},
        "result_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "exception": {"type": ["string", "null"]}
      },
      "oneOf": [
        {"required": ["result_digest"], "not": {"required": ["result_hash"]}},
        {"required": ["result_hash"], "not": {"required": ["result_digest"]}},
        {"not": {"anyOf": [{"required": ["result_digest"]}, {"required": ["result_hash"]}]}}
      ]
    }
  }
}
