{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auditable financial-agent audit result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "opinion", "evidence_sufficiency", "scope_limitation", "max_weighted_severity", "max_effective_severity", "pervasiveness", "human_review_required", "critical_matters", "claim_assessments", "trace_assessment", "basis", "schema_version", "informational_matters"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "opinion": {"type": "string", "enum": ["Clean", "Qualified", "Adverse", "Disclaimer"]},
    "evidence_sufficiency": {"type": "number", "minimum": 0, "maximum": 1},
    "scope_limitation": {"type": "number", "minimum": 0, "maximum": 1},
    "max_weighted_severity": {"type": "number", "minimum": 0},
    "max_effective_severity": {"type": "number", "minimum": 0},
    "pervasiveness": {"type": "number", "minimum": 0, "maximum": 1},
    "human_review_required": {"type": "boolean"},
    "critical_matters": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "claim_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "evidence_valid", "numeric_severity", "effective_severity", "material", "weighted_priority", "reasons"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "evidence_valid": {"type": "boolean"},
          "numeric_severity": {"type": "number", "minimum": 0},
          "effective_severity": {"type": "number", "minimum": 0},
          "material": {"type": "boolean"},
          "weighted_priority": {"type": "number", "minimum": 0},
          "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "trace_assessment": {"$ref": "trace_assessment.schema.json"},
    "basis": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "schema_version": {"const": "2.0"},
    "informational_matters": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
